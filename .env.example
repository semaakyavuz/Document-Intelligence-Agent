# Bu dosyayi .env olarak kopyalayip degerleri doldurun. .env asla git'e eklenmez.

# Hangi saglayici kullanilacak: ollama | groq | gemini
# (Groq embedding sunmaz; EMBEDDING_PROVIDER icin ollama veya gemini secin)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama (yerel sunucu)
OLLAMA_BASE_URL=http://localhost:11434
# Vision Agent'in kullanacagi gorsel model (ollama pull llava)
OLLAMA_VISION_MODEL=llava
# Tek bir cevap icin beklenecek en uzun sure (saniye); CPU'da yuksek tutun
OLLAMA_TIMEOUT_S=600

# Bulut saglayicilar (yalnizca secildiyse gerekli)
GROQ_API_KEY=
GEMINI_API_KEY=

# Veritabani
DATABASE_URL=sqlite:///./data/app.db
