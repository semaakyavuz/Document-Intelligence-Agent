# Bu dosyayi .env olarak kopyalayip degerleri doldurun. .env asla git'e eklenmez.

# Hangi saglayici kullanilacak: ollama | groq | gemini
# (Groq embedding sunmaz; EMBEDDING_PROVIDER icin ollama veya gemini secin)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama (yerel sunucu)
OLLAMA_BASE_URL=http://localhost:11434
# Vision Agent'in kullanacagi gorsel model (ollama pull llava)
OLLAMA_VISION_MODEL=llava
# Tek bir cevap icin beklenecek en uzun sure (saniye); CPU'da yuksek tutun
OLLAMA_TIMEOUT_S=600
# RAG Agent'in kullanacagi embedding modeli (ollama pull nomic-embed-text)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Bulut saglayicilar (yalnizca secildiyse gerekli)
GROQ_API_KEY=
GEMINI_API_KEY=
# Vision Agent'in kullanacagi Gemini modeli. gemini-3.6-flash gunde sadece 20 istek
# veriyordu (ucretsiz katman kotasi); flash-lite ~500/gun veriyor ve ayri bir kota havuzu kullaniyor.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# RAG Agent'in kullanacagi Gemini embedding modeli (EMBEDDING_PROVIDER=gemini ise).
# Bulutta (Render) Ollama olmadigi icin embedding oradan geliyor.
# Neden 001: API'de embedContent destekleyen uc modeli de denedim, ucu de cevap
# veriyor - ama gemini-embedding-2 birden fazla metin verildiginde TEK vektor
# donduruyor (12 belge -> 1 vektor), yani toplu indeksleme sessizce bozuk olurdu.
# 001 ise 12 belge icin 12 vektor donduruyor. Degistirmeden once toplu cagriyi
# gercekten deneyin.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Embedding vektor boyutu. 768: Ollama'nin nomic-embed-text modeliyle AYNI boyut,
# boylece iki saglayici ayni ChromaDB koleksiyon semasini paylasiyor (koleksiyonlar
# boyuta kilitli; farkli boyut "dimension mismatch" hatasi verirdi).
# Dikkat: Gemini yalnizca varsayilan 3072 cikisi normalize ediyor, altina kisilan
# vektorleri ETMIYOR (olculdu: 3072 -> |v|=1.0000, 768 -> |v|=0.5839). Bu yuzden
# vektorleri saglayicinin kendisi L2-normalize ediyor - bu, hangi boyutu
# secerseniz gecerli.
GEMINI_EMBEDDING_DIM=768
# EMBEDDING_PROVIDER ya da yukaridaki model adini degistirirseniz bilgi tabani
# acilista otomatik yeniden indeksleniyor: indekslerken saglayici+model koleksiyon
# metadata'sina damgalaniyor ve damga mevcut ayarla karsilastiriliyor
# (bkz. app/rag_index.py). Ayni boyutta kalmak cokmeyi onler ama Ollama ile Gemini
# vektorleri ayni anlam uzayinda DEGIL - damga kontrolu, sessizce alakasiz kural
# dondurulmesini engelliyor.
# AMA BOYUT bu karsilastirmaya DAHIL DEGIL (metadata'ya yaziliyor, kiyaslanmiyor):
# yalnizca DIM'i degistirirseniz koleksiyon otomatik yenilenmez ve ilk sorguda
# ChromaDB hata verir (olculdu: "Collection expecting embedding with dimension
# of 768, got 1536" - sessiz degil, gorulur bir hata). Bu durumda CHROMA_DB_PATH
# altindaki klasoru silin ki bilgi tabani yeni boyutla yeniden kurulsun.

# Tum saglayicilar icin ortak: 0 = ayni girdi -> ayni cikti (tekrarlanabilir sonuc, degerlendirme icin onerilir)
LLM_TEMPERATURE=0.0

# RAG: yerel, persist edilen vektor veritabani (ChromaDB)
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=invoice_rules
RAG_TOP_K=3

# ValidationAgent'in format kontrolu profili: strict_tr | lenient
# strict_tr: sadece Turk formati sentetik verilerde kullan. lenient: gercek dunya/karma
# faturalarda ve public demo'da kullan (varsayilan).
FORMAT_PROFILE=lenient

# Ayni anda kac fatura pipeline'i calisabilir (en az 1). Fazlasi reddedilmez,
# kuyrukta bekler ve arayuzde "sirada bekleniyor" bildirimi gorur.
# Varsayilan 2, Render'in 512 MB plani icin olculdu: her istek RAG adiminda MCP
# server'i ayri bir surec olarak baslattigi icin ~119 MB daha getiriyor; sinirsiz
# birakildiginda 4 es zamanli istek konteyneri OOM ile oldurttu. Daha buyuk bir
# plana gecerseniz bu degeri artirin.
MAX_CONCURRENT_PIPELINES=2

# Veritabani (docker-compose.yml'deki "document-intelligence-postgres" servisiyle eslesir).
# Host portu 5434: bu makinede zaten "my-postgres" adli baska bir container 5433'u
# kullaniyor, catismamasi icin 5434 secildi. Sifreyi yalnizca burada degistirin;
# DATABASE_URL asagidaki ayni degiskenlere referans verir, iki yerde tutulmaz.
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=invoice_app
POSTGRES_DB=invoice_agent
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}
